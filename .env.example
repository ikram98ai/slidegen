# AWS Infrastructure
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
S3_BUCKET_NAME=slidegen-files-bucket
WEB_BUCKET_NAME=slidegen-web-bucket
# SQS queue for background jobs (production/Lambda only — leave unset locally
# to run jobs in-process). Create with: make create-queue
# JOBS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/slidegen-jobs

# Sibling services (khaneducation, knoio, …). Format: tenant_id:secret,tenant2:secret
# Clients send the secret as the X-Api-Key header.
# SERVICE_API_KEYS=khaneducation:sk_local_dev,knoio:sk_local_dev_2
# EVENT_BUS_NAME=slidegen
# AUTO_GENERATE_CHAPTERS=true
# QDRANT_URL=https://xxxx.cloud.qdrant.io
# QDRANT_API_KEY=
# QDRANT_COLLECTION=slidegen
# EMBEDDING_DIMENSIONS=768

# Security
SECRET_KEY=your_secret_key_for_jwt # Generate: openssl rand -base64 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Services
GEMINI_API_KEY=your_gemini_key
TEXT_MODEL=gemma-4-31b-it
EMBEDDING_MODEL=gemini-embedding-001

# Application
DEBUG=true